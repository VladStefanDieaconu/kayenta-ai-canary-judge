# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Local environment (copy .env.example -> .env) ---
# Every .env variant is ignored, not just the exact name: a backup made before
# rotating a credential (.env.bak, .env.local, .env.2026-07-29) holds the same
# live token as the original, and a rule that names only `.env` does not stop it
# being committed. The example file is the one deliberate exception.
.env*
!.env.example

# --- Credentials: never commit ---
*.pem
*.key
id_rsa*
id_ed25519*

# --- Runtime output: regenerated by the tools; not part of the deliverable ---
# (see data/README.md). The published reference runs are tracked under
# reference-results/; a local `make experiment` writes to results/ instead, so
# your own runs never clobber the published ones.
data/*
!data/README.md
/results/

# --- Logs ---
*.log
