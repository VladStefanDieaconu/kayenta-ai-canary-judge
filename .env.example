# kayenta-ai-canary-judge environment template.
# Copy to ".env" (`cp .env.example .env`) and adjust as needed. Compose reads
# ".env" automatically. Keep ".env" out of git (it is gitignored).

# --- Pinned image tags (always a version, never a floating tag) ------------
# Kayenta: multi-arch (linux/amd64 + linux/arm64), stable 2.36.x.
KAYENTA_IMAGE_TAG=2.36.9
REDIS_IMAGE_TAG=7-alpine
MINIO_IMAGE_TAG=RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE_TAG=RELEASE.2025-07-21T05-28-08Z
VICTORIAMETRICS_IMAGE_TAG=v1.144.0

# --- MinIO / S3 object store (Kayenta config + result store) ---------------
# These double as the credentials Kayenta uses to talk to MinIO.
MINIO_ROOT_USER=kayentaadmin
MINIO_ROOT_PASSWORD=kayentaadmin123
KAYENTA_S3_BUCKET=kayenta
KAYENTA_S3_ROOT_FOLDER=kayenta

# --- Host port mappings ----------------------------------------------------
KAYENTA_PORT=8090
VICTORIAMETRICS_PORT=8428
JUDGE_SERVICE_PORT=5001
REFEREE_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Where the HOST tools look for those services --------------------------
# Compose uses the *_PORT values above to publish the containers. The host-run
# tools in tools/ read these URLs instead. The Makefile includes and exports
# this file, so changing a port above and the matching URL here moves both
# sides together; edit only one and they diverge silently.
KAYENTA_URL=http://localhost:8090
VM_URL=http://localhost:8428
REFEREE_URL=http://localhost:3001

# ===========================================================================
# Configurable AI Remote Judge (LLM + VLM)
# ===========================================================================

# --- LiteLLM gateway (one OpenAI-compatible endpoint in front of everything) ---
LITELLM_IMAGE_TAG=main-v1.74.3-stable
LITELLM_PORT=4000
# Ollama runs on the HOST (Apple-Silicon Metal GPU; can't use the GPU from a
# container on macOS). LiteLLM reaches it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Judge defaults (env fallback when a canary config omits them) ---------
# mode: dummy | ai | hybrid | summary | raw | plot   (dummy = the no-op default)
# model: a registry alias from judge-service/models.yaml (e.g. qwen-llm, moondream-vlm)
JUDGE_MODE=dummy
JUDGE_MODEL=qwen-llm
# Determinism knobs used for AI modes.
JUDGE_TEMPERATURE=0
JUDGE_TOP_P=1.0
# Global generation budget. A single alias may raise it for itself with a
# `max_tokens:` key in judge-service/models.yaml (only gpt-oss-120b-llm does,
# because it spends the budget on reasoning tokens and returns empty content at
# 1024 on the raw representation). Every published number ran at 1024.
JUDGE_MAX_TOKENS=1024
JUDGE_SEED=42
# Which rubric to judge under: a filename stem in prompts/. The frozen default is
# the rubric behind every published number. An unknown id fails the call rather
# than falling back to another prompt.
JUDGE_PROMPT_ID=v1-frozen-2026-06

# --- The eight evaluated local models --------------------------------------
# These tags are exactly what litellm/config.yaml serves. A model that is not
# pulled is SILENTLY SKIPPED rather than failing the run, so pulling a
# different tag from the one below gives you a short scoreboard and no error.
# If you change a tag here, change it in litellm/config.yaml too.
#
# LLMs (text):
#   ollama pull qwen2.5:7b                  # Apache-2.0 | ~4.7 GB  Qwen2.5 7B Instruct
#   ollama pull phi4:14b                    # MIT        | ~9.1 GB  Phi-4 14B
#   ollama pull olmo2:7b                    # Apache-2.0 | ~4.5 GB  OLMo 2 7B (fully open data)
#   ollama pull mistral-nemo:12b            # Apache-2.0 | ~7.1 GB  Mistral-Nemo 12B Instruct
#   ollama pull deepseek-r1:7b              # MIT        | ~4.7 GB  DeepSeek-R1-Distill-Qwen 7B
# VLMs (vision):
#   ollama pull moondream:v2                # Apache-2.0 | ~1.7 GB  Moondream 2
#   ollama pull granite3.2-vision:2b        # Apache-2.0 | ~2.4 GB  Granite 3.2 Vision 2B
#   ollama pull minicpm-v:8b                # see model card | ~5.5 GB  MiniCPM-V 8B
#
# Every alias is a version tag; none floats. The three that previously used a
# floating tag were verified against their version tag before pinning: the
# manifest sha256, the model-weight layer digest and the config digest are
# byte-identical for each pair, so the pin renames the reference without
# changing the artefact. Manifest digests of the artefacts these reproduce:
#   qwen2.5:7b 845dbda0ea48    phi4:14b ac896e5b8b34    olmo2:7b 4208d3b406db
#   mistral-nemo:12b e7e06d107c6c        deepseek-r1:7b 755ced02ce7b
#   moondream:v2 55fc3abd3867  granite3.2-vision:2b 3be41a661804
#   minicpm-v:8b c92bfad01205
# Compare with `ollama list` after pulling.
#
# `make validate-ai` sweeps whichever of these are present and marks the rest
# pending; it needs no particular one.
#
# License-restricted models (the Qwen2.5-VL family with its Tongyi Qianwen EU
# caveat, and Llama / Llama-Vision under the Meta Community License) are left out
# of the evaluated set on purpose. You can still add an alias for them in
# litellm/config.yaml and judge-service/models.yaml; the default runs do not
# include them.

# --- Scored experiment defaults (tools/run_experiment.py) ------------------
# Instances per family. 9 families, so EVAL_N=20 is the published 180-scenario
# run and is what this template sets, so copying it reproduces the paper. The
# code default is 12; lower it here for a faster run. Also settable per
# invocation: `python tools/run_experiment.py --n 5`.
EVAL_N=20
# Dataset master seed. The published runs use 20260621.
EVAL_SEED=20260621
# Comma-separated alias subset to score; empty means every model present.
EVAL_MODELS=

# --- Cloud providers -------------------------------------------------------
# No judge change is needed; set the credentials and add an alias in
# litellm/config.yaml. Keep real keys out of git.
# AWS_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# The two frontier aliases (claude-opus-4-8-vlm, claude-sonnet-5-vlm) authenticate
# with a Bedrock bearer token rather than SigV4, so they need this and not the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair above.
# AWS_BEARER_TOKEN_BEDROCK=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Gateway auth. Only matters if you put LiteLLM behind a key; the bundled
# gateway accepts anything, and the judge sends this value.
# LITELLM_API_KEY=sk-noop
