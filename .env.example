# canaryLLM environment template.
# Copy to ".env" (`cp .env.example .env`) and adjust as needed. Compose reads
# ".env" automatically. Keep ".env" out of git (it is gitignored).

# --- Pinned image tags (avoid :latest) -------------------------------------
# Kayenta: multi-arch (linux/amd64 + linux/arm64), stable 2.36.x.
KAYENTA_IMAGE_TAG=2.36.9
REDIS_IMAGE_TAG=7-alpine
MINIO_IMAGE_TAG=RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE_TAG=RELEASE.2025-07-21T05-28-08Z
VICTORIAMETRICS_IMAGE_TAG=v1.144.0

# --- MinIO / S3 object store (Kayenta config + result store) ---------------
# These double as the credentials Kayenta uses to talk to MinIO.
MINIO_ROOT_USER=kayentaadmin
MINIO_ROOT_PASSWORD=kayentaadmin123
KAYENTA_S3_BUCKET=kayenta
KAYENTA_S3_ROOT_FOLDER=kayenta

# --- Host port mappings ----------------------------------------------------
KAYENTA_PORT=8090
VICTORIAMETRICS_PORT=8428
JUDGE_SERVICE_PORT=5001
REFEREE_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# ===========================================================================
# Configurable AI Remote Judge (LLM + VLM)
# ===========================================================================

# --- LiteLLM gateway (one OpenAI-compatible endpoint in front of everything) ---
LITELLM_IMAGE_TAG=main-v1.74.3-stable
LITELLM_PORT=4000
# Ollama runs on the HOST (Apple-Silicon Metal GPU; can't use the GPU from a
# container on macOS). LiteLLM reaches it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Judge defaults (env fallback when a canary config omits them) ---------
# mode: dummy | ai | hybrid | summary | raw | plot   (dummy = the no-op default)
# model: a registry alias from judge-service/models.yaml (e.g. qwen-llm, moondream-vlm)
JUDGE_MODE=dummy
JUDGE_MODEL=qwen-llm
# Determinism knobs used for AI modes.
JUDGE_TEMPERATURE=0
JUDGE_TOP_P=1.0
JUDGE_MAX_TOKENS=1024
JUDGE_SEED=42

# Local model tags (Ollama). Check availability, license, and size, then
# `ollama pull <tag>`. Each line: modality | license | approx size (Q4).
# The two below are pulled by default and exercised by `make validate-ai`.
OLLAMA_LLM_TAG=qwen2.5:7b            # LLM   | Apache-2.0      | ~4.7 GB  (default LLM)
OLLAMA_VLM_TAG=moondream:v2          # VLM   | Apache-2.0      | ~1.7 GB  (default VLM)

# Others to pull on demand. After `ollama pull`, add the alias to
# litellm/config.yaml and judge-service/models.yaml to score it.
# LLMs (permissively licensed):
#   ollama pull mistral-nemo:12b      # LLM | Apache-2.0 | ~7.1 GB  (Mistral-Nemo 12B Instruct)
#   ollama pull mistral:7b            # LLM | Apache-2.0 | ~4.4 GB  (Mistral 7B; lighter fallback)
#   ollama pull phi4:14b              # LLM | MIT        | ~9.1 GB  (Phi-4 14B)
#   ollama pull olmo2:7b              # LLM | Apache-2.0 | ~4.5 GB  (OLMo 2 7B; fully open data)
#   ollama pull deepseek-r1:7b        # LLM | MIT        | ~4.7 GB  (DeepSeek-R1-Distill-Qwen 7B; reasoning)
# VLMs (permissively licensed):
#   ollama pull smolvlm:2.2b          # VLM | Apache-2.0 | ~1.9 GB  (SmolVLM2; fully open)  [verify tag]
#   ollama pull granite3.2-vision:2b  # VLM | Apache-2.0 | ~2.4 GB  (permissive VLM alt)    [verify tag]
# License-restricted models (the Qwen2.5-VL family with its Tongyi Qianwen EU
# caveat, and Llama / Llama-Vision under the Meta Community License) are left out
# of the evaluated set on purpose. You can still add an alias for them in
# litellm/config.yaml; the default runs do not include them.

# Cloud providers (no judge change; set creds, add an alias in
# litellm/config.yaml). Keep real keys out of git.
# AWS_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
