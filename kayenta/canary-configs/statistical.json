{
  "name": "dummy-statistical",
  "description": "Dummy canary config, built-in statistical judge (NetflixACAJudge-v1.0). Compares Canary=Control vs Canary=Experiment scopes.",
  "configVersion": "1.0",
  "applications": ["ad-hoc"],
  "judge": {
    "name": "NetflixACAJudge-v1.0",
    "judgeConfigurations": {}
  },
  "metrics": [
    {
      "name": "dummy_latency",
      "query": {
        "type": "prometheus",
        "serviceType": "prometheus",
        "metricName": "dummy_latency",
        "customInlineTemplate": "PromQL:sum without(Canary) (dummy_latency{Canary=\"${scope}\"})",
        "labelBindings": []
      },
      "groups": ["dummy-group"],
      "analysisConfigurations": {
        "canary": {
          "direction": "either"
        }
      },
      "scopeName": "default"
    },
    {
      "name": "dummy_error_rate",
      "query": {
        "type": "prometheus",
        "serviceType": "prometheus",
        "metricName": "dummy_error_rate",
        "customInlineTemplate": "PromQL:sum without(Canary) (dummy_error_rate{Canary=\"${scope}\"})",
        "labelBindings": []
      },
      "groups": ["dummy-group"],
      "analysisConfigurations": {
        "canary": {
          "direction": "increase"
        }
      },
      "scopeName": "default"
    }
  ],
  "classifier": {
    "groupWeights": {
      "dummy-group": 100
    },
    "scoreThresholds": {
      "pass": 75,
      "marginal": 50
    }
  }
}
